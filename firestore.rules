rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Catch-all safety gate (First rule defined: deny all by default)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- REUSABLE SECURITY PRIMITIVES ---
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isUserEmail(email) {
      return isAuthenticated() && request.auth.token.email != null && request.auth.token.email.toLowerCase() == email.toLowerCase();
    }

    // Check for trusted backend server key to allow system syncs
    function isServerKey(data) {
      return data != null && 
        data.keys().hasAll(['server_key']) && 
        data.server_key == 'arcadia_secure_server_key_2026_futuristic_studio_token';
    }

    // Safely retrieve the user's role from token claim, database document, or super admin email
    function getUserRole() {
      return isAuthenticated()
        ? (request.auth.token.keys().hasAll(['role']) ? request.auth.token.role :
           (exists(/databases/$(database)/documents/users/$(request.auth.uid))
             ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
             : (request.auth.token.email == 'arcadiadevelopers07@gmail.com' || request.auth.token.email == 'godesportsfreefire@gmail.com' ? 'Owner' : 'Client')))
        : 'Guest';
    }

    // Role Hierarchy Definitions
    function isProjectOwner() {
      return isAuthenticated() && (
        getUserRole() == 'Owner' ||
        request.auth.token.email == 'arcadiadevelopers07@gmail.com' ||
        request.auth.token.email == 'godesportsfreefire@gmail.com' ||
        (request.auth.token.keys().hasAll(['role']) && request.auth.token.role == 'Owner')
      );
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        isProjectOwner() ||
        getUserRole() == 'Super Admin' ||
        (request.auth.token.keys().hasAll(['role']) && request.auth.token.role == 'Super Admin')
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        getUserRole() == 'Admin' ||
        (request.auth.token.keys().hasAll(['role']) && request.auth.token.role == 'Admin')
      );
    }

    function isStaff() {
      return isAuthenticated() && (
        isAdmin() ||
        getUserRole() in ['Manager', 'Staff', 'Employee'] ||
        (request.auth.token.keys().hasAll(['role']) && request.auth.token.role in ['Manager', 'Staff', 'Employee'])
      );
    }

    // String validation for document ID sanity
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Helper shortcuts
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- COLLECTION SECURITY MATCHES ---

    // 1. Users Profile Collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isStaff();
      // Clients can write/update their own profile but cannot alter role or status (prevents privilege escalation)
      allow create: if isStaff() || isOwner(userId) || isServerKey(incoming());
      allow update: if isStaff() || (isOwner(userId) && (!incoming().keys().hasAny(['role', 'status']) || incoming().role == existing().role)) || isServerKey(incoming());
      allow delete: if isSuperAdmin() || isServerKey(existing());
    }

    // 2. Services / Catalog Collection
    match /services/{serviceId} {
      allow read: if true; // Public Guest read
      allow write: if isAdmin() || isServerKey(incoming());
    }

    // 3. Service Categories
    match /categories/{categoryId} {
      allow read: if true; // Public Guest read
      allow write: if isAdmin() || isServerKey(incoming());
    }

    // 4. Pricing Plans
    match /pricingPlans/{planId} {
      allow read: if true; // Public Guest read
      allow write: if isAdmin() || isServerKey(incoming());
    }

    // 5. Maintenance Plans
    match /maintenancePlans/{mPlanId} {
      allow read: if true; // Public Guest read
      allow write: if isAdmin() || isServerKey(incoming());
    }

    // 6. Orders Collection
    match /orders/{orderId} {
      allow read: if true; // Public read for real-time dashboard listeners
      allow create: if true; // Public order placement for guest and authenticated clients
      // Clients CANNOT modify price, status, assigned staff, payment approval, refund approval, or admin notes
      allow update: if isStaff() || (
        isAuthenticated() && (
          existing().customerId == request.auth.uid || 
          existing().email == request.auth.token.email
        ) && !incoming().diff(existing()).affectedKeys().hasAny([
          'total', 'budget', 'subtotal', 'status', 'orderStatus', 'assignedStaff', 
          'paymentStatus', 'isPaid', 'paymentApproval', 'refundStatus', 'refundApproval', 'adminNotes'
        ])
      ) || isServerKey(incoming());
      allow delete: if isAdmin() || isServerKey(existing());
    }

    // 7. Projects Delivery Collection
    match /projects/{projectId} {
      allow read: if isStaff() || (isAuthenticated() && (
        existing().clientId == request.auth.uid || 
        existing().clientEmail == request.auth.token.email
      ));
      // Clients CANNOT edit timeline, budget, status, assigned staff, or completion status
      allow update: if isStaff() || (
        isAuthenticated() && (
          existing().clientId == request.auth.uid || 
          existing().clientEmail == request.auth.token.email
        ) && !incoming().diff(existing()).affectedKeys().hasAny([
          'timeline', 'budget', 'status', 'assignedStaff', 'completion', 'total'
        ])
      ) || isServerKey(incoming());
      allow create, delete: if isAdmin() || isServerKey(incoming());
    }

    // 8. Financial Payments Ledger
    match /payments/{paymentId} {
      allow read: if isAdmin() || (isAuthenticated() && (
        existing().customerId == request.auth.uid || 
        existing().clientEmail == request.auth.token.email
      ));
      // Clients can create payment requests, but CANNOT mark payment as successful or approve payment
      allow create: if (
        isAuthenticated() && (
          incoming().customerId == request.auth.uid || 
          incoming().clientEmail == request.auth.token.email
        ) && (!incoming().keys().hasAny(['paymentStatus', 'status']) || incoming().paymentStatus in ['Pending', 'Processing'])
      ) || isAdmin() || isServerKey(incoming());
      allow update: if isAdmin() || isServerKey(incoming());
      allow delete: if isSuperAdmin() || isServerKey(existing());
    }

    // 9. Refunds Records
    match /refunds/{refundId} {
      allow read: if isAdmin() || (isAuthenticated() && (
        existing().clientId == request.auth.uid || 
        existing().clientEmail == request.auth.token.email
      ));
      // Clients can submit refund requests, but CANNOT approve or complete refunds
      allow create: if (
        isAuthenticated() && (
          incoming().clientId == request.auth.uid || 
          incoming().clientEmail == request.auth.token.email
        ) && (!incoming().keys().hasAny(['status', 'refundStatus']) || incoming().status in ['Requested', 'Pending'])
      ) || isAdmin() || isServerKey(incoming());
      allow update: if isAdmin() || isServerKey(incoming());
      allow delete: if isSuperAdmin() || isServerKey(existing());
    }

    // 10. Maintenance Subscriptions / Contracts
    match /maintenanceSubscriptions/{subId} {
      allow read: if isStaff() || (isAuthenticated() && (
        existing().clientId == request.auth.uid || 
        existing().clientEmail == request.auth.token.email
      ));
      allow write: if isAdmin() || isServerKey(incoming());
    }

    // 11. Inbound Public Contact Messages / Inquiries
    match /contactMessages/{msgId} {
      allow read: if isStaff();
      allow create: if true; // Guest contact submission allowed
      allow update, delete: if isStaff();
    }

    // 12. Portfolio Showcase
    match /portfolio/{portfolioId} {
      allow read: if true; // Public Guest read
      allow write: if isAdmin() || isServerKey(incoming());
    }

    // 13. Customer Reviews Feedback
    match /reviews/{reviewId} {
      allow read: if true; // Public Guest read
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || (isAuthenticated() && existing().userId == request.auth.uid) || isServerKey(incoming());
    }

    // 14. Blogs Articles
    match /blogs/{blogId} {
      allow read: if true; // Public Guest read
      allow write: if isAdmin() || isServerKey(incoming());
    }

    // 15. Frequently Asked Questions (FAQ)
    match /faq/{faqId} {
      allow read: if true; // Public Guest read
      allow write: if isAdmin() || isServerKey(incoming());
    }

    // 16. Testimonials
    match /testimonials/{testId} {
      allow read: if true; // Public Guest read
      allow write: if isAdmin() || isServerKey(incoming());
    }

    // 17. Careers & Vacancies
    match /careers/{jobId} {
      allow read: if true; // Public Guest read
      allow write: if isAdmin() || isServerKey(incoming());
    }

    // 18. Inbound Job Applications
    match /jobApplications/{appId} {
      allow read: if isStaff();
      allow create: if true; // Public job application submission allowed
      allow update, delete: if isStaff();
    }

    // 19. Demo Consultation Bookings
    match /bookings/{bookingId} {
      allow read: if isStaff() || (isAuthenticated() && (
        existing().email == request.auth.token.email || 
        existing().userId == request.auth.uid
      ));
      allow create: if true; // Public demo booking submission allowed
      allow update, delete: if isStaff() || isServerKey(incoming());
    }

    // 20. Actionable Notifications Logs
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (
        existing().userId == request.auth.uid || 
        existing().userEmail == request.auth.token.email ||
        isStaff()
      );
      allow create: if isStaff() || isServerKey(incoming());
      // Users can only update the 'read' badge field on their own notifications
      allow update: if isAuthenticated() && (
        existing().userId == request.auth.uid || 
        existing().userEmail == request.auth.token.email
      ) && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow delete: if isAuthenticated() && (
        existing().userId == request.auth.uid || 
        existing().userEmail == request.auth.token.email
      );
    }

    // 21. Secure Activity Logging (Immutable Audit Logs)
    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isStaff() || isServerKey(incoming());
      allow update, delete: if false; // Immutable logs: NO user/admin modifications allowed
    }

    // 22. SEO Routing Settings (Owner/Super Admin modify, Public read)
    match /seoSettings/{seoId} {
      allow read: if true; // Public render
      allow write: if isSuperAdmin() || isServerKey(incoming());
    }

    // 23. General Global Website Settings
    match /websiteSettings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isServerKey(incoming());
    }

    // 24. Interaction Analytics Counters
    match /analytics/{analyticId} {
      allow read: if isSuperAdmin();
      allow create, write: if true; // Client engagement reporting allowed
    }

    // 25. System Roles & Admins Management (Owner & Super Admin Only)
    match /admins/{adminId} {
      allow read: if isSuperAdmin();
      allow write: if isProjectOwner() || isServerKey(incoming());
    }

    match /roles/{roleId} {
      allow read: if isSuperAdmin();
      allow write: if isProjectOwner() || isServerKey(incoming());
    }

    match /crashReports/{reportId} {
      allow create: if true;
      allow read, update, delete: if isStaff();
    }

    // --- LEGACY BACKWARD COMPATIBLE & AUDITING PATHS ---
    match /arcadia_system_db/{document} {
      allow read: if true;
      allow write: if isAdmin() || isServerKey(incoming());
    }
  }
}
