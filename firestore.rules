rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // REUSABLE SECURITY PRIMITIVES & HELPER FUNCTIONS
    // =========================================================================

    // Verify if the request is coming from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the current user is the owner of a specific resource by UID
    function isOwner(userId) {
      return isAuthenticated() && (request.auth.uid == userId || isProjectOwner());
    }

    // Verify user matching by email address (case-insensitive)
    function isUserEmail(email) {
      return isAuthenticated() && 
        request.auth.token.email != null && 
        request.auth.token.email.toLowerCase() == email.toLowerCase();
    }

    // Verify trusted server key for automated backend synchronization
    function isServerKey(data) {
      return data != null && 
        data.keys().hasAll(['server_key']) && 
        data.server_key == 'arcadia_secure_server_key_2026_futuristic_studio_token';
    }

    // Retrieve the user's role efficiently from token claims, user doc, or owner email fallback
    function getUserRole() {
      return isAuthenticated()
        ? (request.auth.token.keys().hasAll(['role']) 
            ? request.auth.token.role 
            : (exists(/databases/$(database)/documents/users/$(request.auth.uid))
                ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
                : (request.auth.token.email == 'arcadiadevelopers07@gmail.com' || request.auth.token.email == 'godesportsfreefire@gmail.com' ? 'Owner' : 'Client')))
        : 'Guest';
    }

    // 1. Owner: Full Database Access
    function isProjectOwner() {
      return isAuthenticated() && (
        request.auth.token.email == 'arcadiadevelopers07@gmail.com' ||
        request.auth.token.email == 'godesportsfreefire@gmail.com' ||
        (request.auth.token.keys().hasAll(['role']) && request.auth.token.role == 'Owner')
      );
    }

    // 2. Super Admin: High-level administrative authority
    function isSuperAdmin() {
      return isAuthenticated() && (
        isProjectOwner() ||
        getUserRole() == 'Super Admin' ||
        (request.auth.token.keys().hasAll(['role']) && request.auth.token.role == 'Super Admin')
      );
    }

    // 3. Admin: Full management permissions for catalog, analytics, payments, refunds, projects
    function isAdmin() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        getUserRole() == 'Admin' ||
        (request.auth.token.keys().hasAll(['role']) && request.auth.token.role == 'Admin')
      );
    }

    // 4. Staff: Operations team, order handling, customer support, content management
    function isStaff() {
      return isAuthenticated() && (
        isAdmin() ||
        getUserRole() in ['Manager', 'Staff', 'Employee'] ||
        (request.auth.token.keys().hasAll(['role']) && request.auth.token.role in ['Manager', 'Staff', 'Employee'])
      );
    }

    // Convenience payload shortcuts
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // =========================================================================
    // COLLECTION-SPECIFIC SECURITY RULES (EXACTLY ONE MATCH BLOCK PER COLLECTION)
    // =========================================================================

    // 1. Users Profile Collection
    // Authenticated users manage their own profiles. Role & status edits restricted to Admin/Staff to prevent privilege escalation.
    match /users/{userId} {
      allow read: if isOwner(userId) || isStaff();
      allow create: if isOwner(userId) || isStaff() || isServerKey(incoming());
      allow update: if isStaff() || (
        isOwner(userId) && 
        (!incoming().keys().hasAny(['role', 'status', 'permissions']) || incoming().role == existing().role)
      ) || isServerKey(incoming());
      allow delete: if isSuperAdmin() || isServerKey(existing());
    }

    // 2. Services Catalog Collection (Public Read, Admin/Staff Write)
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin() || isServerKey(incoming());
    }

    // 3. Service Categories Collection (Public Read, Admin/Staff Write)
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin() || isServerKey(incoming());
    }

    // 4. Pricing Plans Collection (Public Read, Admin/Staff Write)
    match /pricingPlans/{planId} {
      allow read: if true;
      allow write: if isAdmin() || isServerKey(incoming());
    }

    // 5. Maintenance Plans Collection (Public Read, Admin/Staff Write)
    match /maintenancePlans/{mPlanId} {
      allow read: if true;
      allow write: if isAdmin() || isServerKey(incoming());
    }

    // 6. Orders Collection (Strict Payload & Immutability Rules)
    match /orders/{orderId} {
      allow read: if isStaff() || isOwner(resource.data.customerId) || isUserEmail(resource.data.email) || isUserEmail(resource.data.clientEmail) || isServerKey(resource.data) || true;
      allow create: if isStaff() || isServerKey(incoming()) || (
        isAuthenticated() && 
        (!incoming().keys().hasAny(['price']) || incoming().price >= 0) &&
        (!incoming().keys().hasAny(['subtotal']) || incoming().subtotal >= 0) &&
        (!incoming().keys().hasAny(['total']) || incoming().total >= 0)
      );
      allow update: if isStaff() || isServerKey(incoming()) || (
        isOwner(resource.data.customerId) &&
        (!incoming().diff(resource.data).affectedKeys().hasAny(['customerId', 'userId', 'price', 'subtotal', 'total']) || isStaff())
      );
      allow delete: if isAdmin() || isServerKey(existing());
    }

    // 7. Projects Delivery Collection
    match /projects/{projectId} {
      allow read: if isStaff() || isOwner(resource.data.clientId) || isUserEmail(resource.data.clientEmail) || isServerKey(resource.data) || true;
      allow create: if isStaff() || isServerKey(incoming()) || isAuthenticated();
      allow update: if isStaff() || isServerKey(incoming()) || (
        isOwner(resource.data.clientId) &&
        !incoming().diff(resource.data).affectedKeys().hasAny(['sourceCodeLink', 'clientId'])
      );
      allow delete: if isAdmin() || isServerKey(existing());
    }

    // 8. Financial Payments Ledger
    match /payments/{paymentId} {
      allow read: if isStaff() || isOwner(resource.data.clientId) || isUserEmail(resource.data.clientEmail) || isServerKey(resource.data) || true;
      allow create: if isStaff() || isServerKey(incoming()) || isAuthenticated();
      allow update, delete: if isStaff() || isServerKey(existing());
    }

    // 9. Refunds Records
    match /refunds/{refundId} {
      allow read: if isStaff() || isOwner(resource.data.clientId) || isUserEmail(resource.data.clientEmail) || isServerKey(resource.data) || true;
      allow write: if isStaff() || isServerKey(incoming());
    }

    // 10. Maintenance Subscriptions / Contracts
    match /maintenanceSubscriptions/{subId} {
      allow read: if isStaff() || isOwner(resource.data.clientId) || isUserEmail(resource.data.clientEmail) || isServerKey(resource.data) || true;
      allow write: if isStaff() || isServerKey(incoming());
    }

    // 11. Inbound Public Contact Messages / Inquiries (Buffer Exhaustion Protection)
    match /contactMessages/{msgId} {
      allow read: if isStaff() || isServerKey(resource.data);
      allow create: if (incoming().message == null || incoming().message.size() < 10000) || isServerKey(incoming());
      allow update, delete: if isStaff() || isServerKey(existing());
    }

    // 12. Portfolio Showcase
    match /portfolio/{portfolioId} {
      allow read: if true;
      allow write: if isAdmin() || isServerKey(incoming());
    }

    // 13. Customer Reviews & Feedback
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() || isServerKey(incoming());
      allow update, delete: if isStaff() || isServerKey(existing());
    }

    // 14. Blog Articles Collection
    match /blogs/{blogId} {
      allow read: if true;
      allow write: if isAdmin() || isServerKey(incoming());
    }

    // 15. Frequently Asked Questions / FAQ
    match /faq/{faqId} {
      allow read: if true;
      allow write: if isAdmin() || isServerKey(incoming());
    }

    // 16. Testimonials Collection
    match /testimonials/{testId} {
      allow read: if true;
      allow write: if isAdmin() || isServerKey(incoming());
    }

    // 17. Careers & Job Vacancies Collection
    match /careers/{jobId} {
      allow read: if true;
      allow write: if isAdmin() || isServerKey(incoming());
    }

    // 18. Inbound Job Applications Collection
    match /jobApplications/{appId} {
      allow read: if isStaff() || isServerKey(resource.data);
      allow create: if true;
      allow update, delete: if isStaff() || isServerKey(existing());
    }

    // 19. Demo Consultation Bookings Collection
    match /bookings/{bookingId} {
      allow read: if isStaff() || isOwner(resource.data.userId) || isUserEmail(resource.data.email) || isServerKey(resource.data) || true;
      allow create: if isAuthenticated() || isServerKey(incoming());
      allow update, delete: if isStaff() || isOwner(resource.data.userId) || isServerKey(existing());
    }

    // 20. System Notifications Collection
    match /notifications/{notifId} {
      allow read: if isStaff() || isOwner(resource.data.userId) || isUserEmail(resource.data.userEmail) || isUserEmail(resource.data.clientEmail) || isServerKey(resource.data) || true;
      allow create: if isAuthenticated() || isServerKey(incoming());
      allow update: if isStaff() || isOwner(resource.data.userId) || isUserEmail(resource.data.userEmail) || isServerKey(incoming());
      allow delete: if isStaff() || isServerKey(existing());
    }

    // 21. Activity Logging Collection (Immutable Audit Logs)
    match /activityLogs/{logId} {
      allow read: if isStaff() || isAdmin();
      allow create: if isAuthenticated() || isServerKey(incoming());
      allow update, delete: if false; // Immutable: no edits or deletions permitted
    }

    // 22. SEO Settings Collection (Public Read, Admin Write)
    match /seoSettings/{seoId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isServerKey(incoming());
    }

    // 23. Website Global Settings Collection (Public Read, Admin Write)
    match /websiteSettings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isServerKey(incoming());
    }

    // 24. Interaction Analytics Collection
    match /analytics/{analyticId} {
      allow read: if isStaff() || isAdmin();
      allow create, write: if true;
    }

    // 25. Crash Reports Collection (Public Log, Staff Read)
    match /crashReports/{reportId} {
      allow create: if true;
      allow read, update, delete: if isStaff();
    }

    // 26. RBAC Admins Management (Owner & Super Admin Only)
    match /admins/{adminId} {
      allow read: if isSuperAdmin();
      allow write: if isProjectOwner() || isServerKey(incoming());
    }

    // 27. RBAC Roles Management (Owner & Super Admin Only)
    match /roles/{roleId} {
      allow read: if isSuperAdmin();
      allow write: if isProjectOwner() || isServerKey(incoming());
    }

    // 28. System Database Backup Collection
    match /arcadia_system_db/{document} {
      allow read: if true;
      allow write: if isAdmin() || isServerKey(incoming());
    }
  }
}
