{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/test-all",
      "destination": "/api/test-all"
    },
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/firebase-config.js",
      "destination": "/api"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api"
    },
    {
      "source": "/robots.txt",
      "destination": "/api"
    },
    {
      "source": "/auth/callback",
      "destination": "/api"
    },
    {
      "source": "/auth/callback/",
      "destination": "/api"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
